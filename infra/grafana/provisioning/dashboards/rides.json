      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "rides-api"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
