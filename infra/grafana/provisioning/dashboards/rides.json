          "root_selector": "",
          "columns": [
            {
              "selector": "detected_at",
              "text": "detected_at",
              "type": "timestamp"
            },
            {
              "selector": "window_start",
              "text": "window_start",
              "type": "timestamp"
            },
            {
              "selector": "zone",
              "text": "zone",
              "type": "string"
            },
            {
              "selector": "kind",
              "text": "kind",
